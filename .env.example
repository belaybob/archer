# PostgreSQL connection string. Works with Netlify DB (Neon), Supabase, RDS,
# or a local Postgres instance -- Prisma doesn't care which.
DATABASE_URL="postgresql://user:password@localhost:5432/archer"

# Session/auth secret -- generate with `openssl rand -base64 32`
AUTH_SECRET=""

# Base URL of the deployed site (used for building absolute links, e.g. in emails)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
